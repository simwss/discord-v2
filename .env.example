# Copy to .env and fill in. Never commit the real .env.

# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application ID from the same page -> General Information
DISCORD_APP_ID=
# Optional: register slash commands to a single guild instead of globally.
# Guild registration is instant; global registration can take up to an hour.
# Leave empty for global registration.
DISCORD_GUILD_ID=

# ---- Firebase Realtime Database ----
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
# Optional, only needed if you use the matching Firebase products.
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Runtime ----
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# HTTP port for the /health and /ready probes. Set to 0 to disable the server.
HEALTH_PORT=3001
# Comma-separated Discord user IDs that may not use any command.
BANNED_USER_IDS=
