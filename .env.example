# Copy to .env and fill in. Never commit the real .env.

# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application ID from the same page -> General Information
DISCORD_APP_ID=
# Optional: register slash commands to a single guild instead of globally.
# Guild registration is instant; global registration can take up to an hour.
# Leave empty for global registration.
DISCORD_GUILD_ID=

# ---- Postgres ----
# Used by Compose to provision the database container.
POSTGRES_DB=rasselbande
POSTGRES_USER=rasselbande
POSTGRES_PASSWORD=

# Connection string for the bot. Compose overrides this to point at the
# `postgres` service; the value here is what a bot started outside Compose
# (npm run dev) uses, so it goes through the port published on localhost.
DATABASE_URL=postgres://rasselbande:CHANGE_ME@localhost:5432/rasselbande
# Maximum pooled connections. The default suits a single bot process.
DATABASE_POOL_MAX=10
# off | on | no-verify. Managed providers usually need `no-verify` unless you
# also supply their CA. The Compose database is on a private network: off.
DATABASE_SSL=off

# ---- Runtime ----
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# HTTP port for the /health and /ready probes. Set to 0 to disable the server.
HEALTH_PORT=3001
# Comma-separated Discord user IDs that may not use any command.
BANNED_USER_IDS=
