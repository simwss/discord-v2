# Keep the build context minimal: every file here is a cache-buster.
# The Dockerfile copies only what it needs, so this is defence in depth —
# most importantly it guarantees .env can never be baked into an image.

.env
.env.*
!.env.example

firebase-export.json
*.dump
*.sql.gz

.git
.github
.gitignore
.dockerignore
.editorconfig
.nvmrc
.prettierignore
.prettierrc.json

node_modules
dist
coverage
*.tsbuildinfo
*.log

Dockerfile
compose.yaml
docker-compose*

README.md
docs
renovate.json
eslint.config.js
vitest.config.ts
